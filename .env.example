# Server-side AI access. Never commit real keys.
AGNES_API_KEY=
AGNES_MODEL=agnes-2.5-flash

# ElevenLabs voice generation.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_v3

# Replicate-hosted ACE-Step 1.5 music generation.
REPLICATE_API_TOKEN=

# Neon Postgres.
DATABASE_URL=

# Wildcard project hosts, such as <slug>.ttcgamelab.space.
PROJECT_BASE_DOMAIN=
NEXT_PUBLIC_PROJECT_BASE_DOMAIN=

# Off-site full backup storage (Oracle Cloud Object Storage, S3-compatible).
# When all five are set, every backup snapshot also copies the snapshot data
# and every project's media files to this separate bucket.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_BUCKET=
